{
  "name": "testforge",
  "version": "1.0.0",
  "description": "Motor Unificado de Automatización UI/API (Web + Mobile) — Enterprise SaaS Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
